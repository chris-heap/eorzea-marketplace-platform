# =============================================================================
# Eorzea Market Anomaly Detection Platform
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# -- Kafka --
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_LISTINGS=market.listings.raw
KAFKA_TOPIC_SALES=market.sales.raw

# -- MinIO (local S3) --
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# -- S3 Buckets --
S3_BUCKET_RAW=eorzea-raw
S3_BUCKET_STAGING=eorzea-staging
S3_BUCKET_MART=eorzea-mart

# -- Universalis API --
UNIVERSALIS_WS_URL=wss://universalis.app/api/ws
UNIVERSALIS_REST_URL=https://universalis.app/api/v2

# -- FFXIV Worlds --
FFXIV_WORLDS=Cactuar,Famfrit,Jenova,Midgardsormr,Sargatanas,Siren

# -- Flink --
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081

# -- Snowflake (Phase 3) --
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=EORZEA_WH
# SNOWFLAKE_DATABASE=EORZEA_DB

# -- MLflow (Phase 4) --
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# -- FastAPI (Phase 5) --
API_HOST=0.0.0.0
API_PORT=8000
